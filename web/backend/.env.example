IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_API_KEY=sk-...
# fal_trellis2 (default): hosted fal.ai fal-ai/trellis-2, no local ComfyUI
# needed. Requires FAL_KEY. Do NOT switch this to plain "fal-ai/trellis" --
# that's the original, shape-only model and would silently reactivate the
# reference_color.py fallback (see CLAUDE.md).
# trellis_local: your own locally-run ComfyUI + TRELLIS 2 workflow --
# useful for offline dev, or to compare output against the hosted version.
MESH_GEN_PROVIDER=fal_trellis2

# --- fal_trellis2 settings ---
FAL_KEY=
FAL_TRELLIS2_RESOLUTION=1024
FAL_TRELLIS2_POLL_INTERVAL_S=5
FAL_TRELLIS2_TIMEOUT_S=600

# --- trellis_local settings (only used when MESH_GEN_PROVIDER=trellis_local) ---
COMFYUI_URL=http://127.0.0.1:8188
# Leave TRELLIS_WORKFLOW_JSON unset to use the workflow bundled at
# app/clients/trellis_workflow_api.json. Only set it to point at a
# different workflow file -- an empty value is NOT the same as unset.
TRELLIS_OUTPUT_NODE_ID=232
TRELLIS_IMAGE_NODE_ID=6
TRELLIS_TIMEOUT_S=1800
TRELLIS_POLL_INTERVAL_S=3

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value in production than local dev -- never the same secret.
AUTH_SECRET_KEY=

# --- Postgres (Phase 2). Unset -> falls back to a local SQLite file, no
# extra setup needed for local dev. ---
DATABASE_URL=

# --- Cloudflare R2 (Phase 2). Unset -> falls back to local disk storage
# under jobs/, no extra setup needed for local dev. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brickforge-jobs

# --- Redis / job queue (Phase 3). Unset -> falls back to running the
# pipeline in-process via BackgroundTasks, no extra setup needed for local
# dev -- but then there's nothing for worker.py to do; run without it. ---
REDIS_URL=

# --- Production hardening (Phase 4) ---
# Comma-separated. This is what CORS actually allows -- keep it to real
# frontend origins, never "*".
ALLOWED_ORIGINS=http://localhost:3000
# Unset -> Sentry is a no-op in both the API and the worker.
SENTRY_DSN=
# Per-user hourly generation cap = max(3, ceil(plan's monthly credits /
# this)). Only the divisor is configurable -- see rate_limit.py for why a
# flat per-plan number doesn't work.
RATE_LIMIT_DIVISOR=2
# Total generations per day across every user, the backstop against a
# runaway bill that per-user limits alone wouldn't catch.
DAILY_GENERATION_CEILING=100
# Unset/false -> /docs, /redoc, /openapi.json are disabled (the safe
# default -- no reason to hand a public API's full route surface to
# anyone who asks). Set to true for local dev or ad-hoc debugging.
ENABLE_API_DOCS=false
# Unset -> everyone can generate (the normal, default state). Set to a
# comma-separated list of emails to restrict POST /generate to just those
# accounts -- e.g. while payments aren't live and every generation is a
# real API cost with no revenue behind it yet. Signup/login stay open
# either way; only generation itself is gated.
GENERATION_ALLOWLIST=
