# Python (core/brickforge)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# BrickLink Studio's own auto-backup files (Studio's .io project format is
# explicitly not the canonical output here -- see CLAUDE.md's "Product
# constraints": .ldr/.mpd is canonical, .io is a later addition, not a
# prerequisite). These accumulate as Studio auto-saves copies on open --
# left on disk, just not tracked.
*.io

# Claude Code local tooling config -- dev-only, not product content.
.claude/

# Internal build-history/planning docs -- candid, detailed writeups of the
# proprietary brick-placement/structural-repair engine and unreleased
# roadmap thinking (kept locally, not tracked going forward now that this
# repo may go public). Note: their content still exists in past commits --
# untracking here doesn't scrub git history.
CLAUDE.md
DESIGN.md
HANDOFF.md

# Secrets -- real .env files carry live API keys and must never be
# committed. .env.example (the template, no real values) is intentionally
# still tracked.
.env
*.env
!.env.example
