{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8532"],
      "port": 8532
    },
    {
      "name": "backend",
      "runtimeExecutable": "web/backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000", "--app-dir", "web/backend"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "C:/Program Files/nodejs/node.exe",
      "runtimeArgs": ["web/frontend/node_modules/next/dist/bin/next", "dev", "web/frontend", "--port", "3000"],
      "port": 3000
    }
  ]
}
